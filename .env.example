# Optional: if unset, a random key is generated in instance/.secret_key
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PORT=8110

# Public URL of this instance, used for links in notification mails
BASE_URL=https://slots.example.com

# Default UI language (de or en)
DEFAULT_LANGUAGE=de
# Organization name shown in the header (the settings page can override it)
# ORG_NAME=Example Hospital

# SMTP for vote notifications (optional).
# Admins can also set these on /admin/settings; saved values take precedence.
# Key for encrypting the SMTP password saved on /admin/settings.
# If unset, a random key is created once in instance/.settings_key.
# Set it here to keep the key out of the instance folder (and its backups).
SETTINGS_KEY=

# SMTP_SECURITY: starttls, ssl or none (default: starttls when user and password are set)
SMTP_SECURITY=starttls
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-password
SMTP_FROM=noreply@example.com
